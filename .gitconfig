[github]
user = 7onn

[user]
email = tom.garcia@trading212.com
name = Tom Garcia
signingkey = 0xD165AF52B2B44EAA

[commit]
gpgsign = true

[color]
diff = auto
status = auto
branch = auto
interactive = auto
ui = true
pager = true

[alias]
lg = log --graph --all

[core]
excludesfile = ~/.gitignore_global

[push]
default = simple

[pull]
rebase = false

[filter "lfs"]
required = true
clean = git-lfs clean -- %f
smudge = git-lfs smudge -- %f
process = git-lfs filter-process

[init]
defaultBranch = main
templateDir = /Users/tom.garcia/.git-template

[url "ssh://git@github.com/Trading212Dev/"]
insteadOf = https://github.com/Trading212Dev/

[url "ssh://git@github.com/trading212/"]
insteadOf = https://github.com/trading212/

[advice]
detachedHead = false
